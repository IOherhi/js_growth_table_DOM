"use strict";
var button = document.body.querySelector(".button");
var field = document.body.querySelector(".field");
/* #append-row-AND-remove-row*/ var rowButton = document.body.querySelector(".append-row");
rowButton.addEventListener("click", function(e) {
    var fieldCildrens = field.querySelectorAll("tr");
    var lastChildField = fieldCildrens[fieldCildrens.length - 1].children;
    var tr = document.createElement("tr");
    if (fieldCildrens.length === 10) return;
    Array.from(lastChildField).forEach(function() {
        var td = document.createElement("td");
        tr.append(td);
    });
    field.append(tr);
});
var rowRemove = document.body.querySelector(".remove-row");
rowRemove.onclick = function(e) {
    var fieldNodeList = field.querySelectorAll("tr");
    if (fieldNodeList.length > 4) fieldNodeList[fieldNodeList.length - 1].remove();
};
/* #.append-column-AND-remove-column*/ var columButton = document.body.querySelector(".append-column");
columButton.addEventListener("click", function(e) {
    var fieldCinds = field.querySelectorAll("tr");
    var FIRTS_CHILD_FIELD_LENGTH = fieldCinds[0].children.length;
    if (FIRTS_CHILD_FIELD_LENGTH === 10) return;
